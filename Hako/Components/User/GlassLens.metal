//
//  GlassLens.metal
//  Hako
//  Completely generated by Claude
//
//  Edge refraction for ClearSegmentedPicker's indicator.
//  Applied with .layerEffect to the picker's labels. Inside the capsule, only a thin band
//  along the rim is distorted: content is bent inwards towards the centre, and split into a
//  rainbow fringe like light dispersing through glass. The centre is untouched (no zoom).
//

#include <metal_stdlib>
#include <SwiftUI/SwiftUI_Metal.h>
using namespace metal;

// Tunables
constant float kRimWidth   = 12.0; // max width (points) of the distorted band
constant float kBend       = 10.0; // how far (points) the rim bends content at full strength
constant float kDispersion = 0.55; // rainbow spread, as a fraction of the bend (0 = none)
constant int   kTaps       = 7;    // spectrum samples; more = smoother rainbow

// rect     = (x, y, width, height) of the lens capsule in the layer's coordinate space
// strength = 0 -> no effect, 1 -> full refraction
[[ stitchable ]]
half4 glassLens(float2 position, SwiftUI::Layer layer, float4 rect, float strength) {
    float2 halfSize = rect.zw * 0.5;
    float2 center = rect.xy + halfSize;
    float2 p = position - center;

    // Signed distance to a capsule (negative inside) and its outward normal.
    float radius = halfSize.y;
    float2 q = float2(sign(p.x) * max(abs(p.x) - (halfSize.x - radius), 0.0), p.y);
    float qLen = length(q);
    float dist = qLen - radius;

    if (strength <= 0.0 || dist >= 0.0) {
        return layer.sample(position);
    }

    float2 normal = qLen > 1e-3 ? q / qLen : float2(0.0, 1.0);

    // 1 right at the rim, falling to 0 at the inner edge of the band.
    float rimWidth = min(radius, kRimWidth);
    float t = clamp(1.0 + dist / rimWidth, 0.0, 1.0);
    float bend = kBend * strength * t * t;

    // Sample from further *inside* the capsule, so content appears bent inwards at the rim.
    // Each tap sits at a slightly different bend, one per wavelength from red to blue.
    float3 colorSum = float3(0.0);
    float alphaSum = 0.0;
    float3 chanAlpha = float3(0.0);
    float3 chanWeight = float3(0.0);

    for (int i = 0; i < kTaps; i++) {
        float s = float(i) / float(kTaps - 1);               // 0 = red, 1 = blue
        float3 w = float3(max(1.0 - 2.0 * s, 0.0),           // red weight
                          1.0 - abs(2.0 * s - 1.0),          // green weight
                          max(2.0 * s - 1.0, 0.0));          // blue weight
        float amount = bend * (1.0 + (s - 0.5) * 2.0 * kDispersion);
        float4 tap = float4(layer.sample(position - normal * amount));

        colorSum += tap.rgb;
        alphaSum += tap.a;
        chanAlpha += w * tap.a;
        chanWeight += w;
    }

    chanAlpha /= max(chanWeight, float3(1e-4));              // coverage seen by each colour channel
    float maxAlpha = max(chanAlpha.r, max(chanAlpha.g, chanAlpha.b));
    if (maxAlpha <= 1e-4) {
        return half4(0.0);
    }

    // Average (unpremultiplied) label colour.
    float3 textColor = colorSum / max(alphaSum, 1e-4);

    // Where the channels disagree about coverage, the lacking channels fall back to the colour the
    // text is likely sitting on (white behind dark text, black behind light text), giving coloured fringes.
    float luminance = dot(textColor, float3(0.299, 0.587, 0.114));
    float backdrop = luminance > 0.5 ? 0.0 : 1.0;
    float3 color = mix(float3(backdrop), textColor, chanAlpha / maxAlpha);

    return half4(half3(color * maxAlpha), half(maxAlpha));
}
